{
  "name": "node-simple-scaffold",
  "version": "1.0.5",
  "description": "Modular Node.js, Express, Sequelize (MySQL) & Mongoose (MongoDB) REST API starter with CLI scaffolding and code generation for models, controllers, services, modules, middleware, migrations, relations, events, notifications, cron jobs, seeders and tests",
  "main": "bin/cli.js",
  "bin": {
    "node-simple-scaffold": "bin/cli.js",
    "scaffold": "bin/cli.js"
  },
  "preferGlobal": true,
  "type": "commonjs",
  "author": "krishnapawar",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishnapawar/node-simple-scaffold.git"
  },
  "bugs": {
    "url": "https://github.com/krishnapawar/node-simple-scaffold/issues"
  },
  "homepage": "https://github.com/krishnapawar/node-simple-scaffold#readme",
  "keywords": [
    "cli",
    "node-simple-scaffold",
    "npx node-simple-scaffold",
    "node-scaffold",
    "scaffold",
    "scaffolding",
    "generator",
    "express",
    "sequelize",
    "mysql",
    "mongodb",
    "mongoose",
    "node",
    "rest-api",
    "structure",
    "boilerplate",
    "kp",
    "krishnapawar",
    "krishna"
  ],
  "files": [
    "bin",
    "scripts",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "structure": "node bin/cli.js structure",
    "make:auth": "node bin/cli.js make:auth",
    "cli": "node bin/cli.js"
  }
}